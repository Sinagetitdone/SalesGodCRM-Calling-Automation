@echo off
rem Called in the launcher's setlocal scope. No global PATH or policy changes.
where node >nul 2>nul
if not errorlevel 1 (
  for /f "tokens=1 delims=." %%N in ('node --version 2^>nul') do if "%%N"=="v24" (
    where npm.cmd >nul 2>nul
    if not errorlevel 1 exit /b 0
  )
)
for %%R in ("%~dp0..\..") do set "SALESGOD_PACKAGE_ROOT=%%~fR"
echo Preparing a private Node.js 24 runtime from nodejs.org. Internet is needed on first use.
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; function Test-NodeHash([string]$path,[string]$expected) { $reader=[IO.File]::OpenRead($path); $hasher=[Security.Cryptography.SHA256]::Create(); try { return ([BitConverter]::ToString($hasher.ComputeHash($reader))).Replace('-','').ToLowerInvariant() -eq $expected } finally { $reader.Dispose(); $hasher.Dispose() } }; try { $root=$env:SALESGOD_PACKAGE_ROOT; $version=(Get-Content -LiteralPath (Join-Path $root 'tools\distribution\NODE-VERSION.txt') -Raw).Trim(); if($version -notmatch '^v24\.\d+\.\d+$'){throw 'Invalid Node version'}; $arch=$env:PROCESSOR_ARCHITECTURE; if($env:PROCESSOR_ARCHITEW6432){$arch=$env:PROCESSOR_ARCHITEW6432}; if($arch -eq 'ARM64'){$arch='arm64'}elseif($arch -eq 'AMD64'){$arch='x64'}else{throw 'This package needs 64-bit Windows (x64 or ARM64)'}; $name='node-'+$version+'-win-'+$arch; $file=$name+'.zip'; $line=@(Get-Content -LiteralPath (Join-Path $root 'tools\distribution\NODE-SHASUMS256.txt') | Where-Object { ($_ -split '\s+')[1] -eq $file }); if($line.Count -ne 1){throw 'Missing pinned checksum'}; $hash=($line[0] -split '\s+')[0]; if($hash -notmatch '^[a-f0-9]{64}$'){throw 'Invalid pinned checksum'}; $cache=Join-Path $root '.runtime'; [IO.Directory]::CreateDirectory($cache) | Out-Null; $lock=[IO.File]::Open((Join-Path $cache 'download.lock'),'OpenOrCreate','ReadWrite','None'); try { $archive=Join-Path $cache $file; if(!(Test-Path -LiteralPath $archive)){ $partial=$archive+'.partial'; $ProgressPreference='SilentlyContinue'; Invoke-WebRequest -UseBasicParsing -Uri ('https://nodejs.org/dist/'+$version+'/'+$file) -OutFile $partial -TimeoutSec 180; if(!(Test-NodeHash $partial $hash)){throw 'Node download checksum failed; nothing will run'}; Move-Item -LiteralPath $partial -Destination $archive -Force }; if(!(Test-NodeHash $archive $hash)){throw 'Cached Node checksum failed; ask IT to review the .runtime folder'}; $nodeHome=Join-Path $cache $name; $node=Join-Path $nodeHome 'node.exe'; if(!(Test-Path -LiteralPath $node)){if(Test-Path -LiteralPath $nodeHome){throw 'Incomplete cached runtime; ask IT to review .runtime'}; $tar=Join-Path $env:SystemRoot 'System32\tar.exe'; if(!(Test-Path -LiteralPath $tar)){throw 'Windows built-in tar.exe is required; ask IT to update Windows'}; $stage=Join-Path $cache ('unpack-'+[Guid]::NewGuid().ToString('N')); [IO.Directory]::CreateDirectory($stage) | Out-Null; & $tar -xf $archive -C $stage; if($LASTEXITCODE -ne 0){throw 'Node extraction failed'}; $expanded=Join-Path $stage $name; $boundary=[IO.Path]::GetFullPath($cache)+[IO.Path]::DirectorySeparatorChar; if(![IO.Path]::GetFullPath($expanded).StartsWith($boundary,[StringComparison]::OrdinalIgnoreCase) -or ![IO.Path]::GetFullPath($nodeHome).StartsWith($boundary,[StringComparison]::OrdinalIgnoreCase)){throw 'Invalid runtime path'}; [IO.Directory]::Move($expanded,$nodeHome); [IO.Directory]::Delete($stage)}; if((& $node --version) -ne $version){throw 'Node version check failed'}; if(!(Test-Path -LiteralPath (Join-Path $nodeHome 'npm.cmd'))){throw 'npm is missing from the runtime'}; [IO.File]::WriteAllText((Join-Path $cache 'node-home.txt'),$nodeHome) } finally { $lock.Dispose() }; exit 0 } catch { Write-Host ('Node setup failed: '+$_.Exception.Message); Write-Host 'Check internet access and folder permissions, then retry. No system settings were changed.'; exit 1 }"
if errorlevel 1 exit /b 1
for /f "usebackq delims=" %%P in ("%SALESGOD_PACKAGE_ROOT%\.runtime\node-home.txt") do set "SALESGOD_NODE_HOME=%%P"
set "PATH=%SALESGOD_NODE_HOME%;%PATH%"
exit /b 0
