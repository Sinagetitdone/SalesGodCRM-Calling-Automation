#!/bin/bash
# Application bundle remains beside the rest of the extracted team package.
bundle_root="$(cd -- "$(dirname -- "$0")/../../.." && pwd)" || exit 1
if [ ! -f "$bundle_root/Start Mac.command" ]; then
  /usr/bin/osascript -e 'display alert "SalesGod Bridge files not found" message "Extract the entire SalesGod-Team ZIP. Keep SalesGod Bridge.app in that folder beside Start Mac.command. Create a Finder alias for your desktop instead of moving the app alone." as critical'
  exit 1
fi
# Finder opens the normal Terminal launcher with no command typing. Terminal
# owns the bridge lifecycle and displays bootstrap progress or actionable errors.
exec /usr/bin/open -a Terminal "$bundle_root/Start Mac.command"
