{
  "name": "salesgodcrm-calling-automation",
  "private": true,
  "version": "0.1.0",
  "description": "Permission-based calling automation around SalesGodCRM",
  "type": "module",
  "scripts": {
    "package:team": "node tools/distribution/build-package.mjs",
    "package:check": "node --test tools/distribution/checks.mjs",
    "audio:bridge": "node --env-file-if-exists=.env tools/audio-bridge/server.mjs",
    "audio:check": "node --test tools/audio-bridge/bridge-checks.mjs tools/audio-bridge/voice-checks.mjs tools/audio-bridge/call-checks.mjs tools/audio-bridge/voicemail-checks.mjs tools/audio-bridge/campaign-checks.mjs",
    "audio:extension:check": "node --test tools/audio-extension/tests/checks.mjs tools/audio-extension/tests/signaling-checks.mjs tools/audio-extension/tests/window-signaling-checks.mjs tools/audio-extension/tests/campaign-driver-checks.mjs",
    "api:check": "node --test tools/api-check.mjs",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test && npm run audio:check && npm run audio:extension:check && npm run api:check && npm run package:check",
    "dev": "tsx src/server.ts",
    "smoke": "tsx src/local-smoke.ts",
    "smoke:failure": "tsx src/local-failure-smoke.ts",
    "smoke:persistence": "tsx src/local-persistence-smoke.ts",
    "start": "tsx src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "fastify": "^5.0.0"
  }
}
