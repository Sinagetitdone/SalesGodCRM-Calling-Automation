{
  "name": "salesgodcrm-calling-automation",
  "private": true,
  "version": "0.1.0",
  "description": "Permission-based calling automation around SalesGodCRM",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test",
    "dev": "tsx src/server.ts",
    "smoke": "tsx src/local-smoke.ts",
    "smoke:failure": "tsx src/local-failure-smoke.ts",
    "smoke:persistence": "tsx src/local-persistence-smoke.ts",
    "start": "tsx src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "fastify": "^5.0.0"
  }
}
